# description: preserve fulltext DDL row projection, token counts and query scores.

connect(sys_conn, $OBMYSQL_MS0, root@sys,,oceanbase, $OBMYSQL_PORT);
connection sys_conn;

alter system set _enable_add_fulltext_index_to_existing_table = true;
--disable_warnings
drop database if exists fts_hot_path;
--enable_warnings
create database fts_hot_path;
use fts_hot_path;

# Existing rows exercise both word/doc-id column orders during auxiliary DDL.
create table docs (
  id bigint primary key,
  title varchar(256),
  body longtext
) charset utf8mb4;
insert into docs values
  (1, 'Databases running', 'Database database search searching systems'),
  (2, 'Search engines', 'Running runners search database'),
  (3, '数据库检索', '数据库全文检索，数据库性能优化。'),
  (4, 'Mixed 数据库', 'Database 数据库 search 全文检索'),
  (5, '', ''),
  (6, NULL, NULL),
  (7, 'Stop words', 'the and or a an');
insert into docs values
  (8, 'Long running document', repeat('Database search running 数据库全文检索 ', 200));
create fulltext index ft_beng on docs(title, body) with parser beng;
create fulltext index ft_ik on docs(body) with parser ik;

select id, round(match(title, body) against ('database search'), 8) as score
from docs where match(title, body) against ('database search') order by id;
select id, round(match(body) against ('数据库全文检索'), 8) as score
from docs where match(body) against ('数据库全文检索') order by id;
select id, round(match(title, body) against ('running'), 8) as score
from docs where match(title, body) against ('running') order by score desc, id limit 3;
select id from docs where match(title, body) against ('+database +search' in boolean mode) order by id;
select id from docs where match(title, body) against ('+database -runners' in boolean mode) order by id;
select id from docs where match(body) against ('数据库 search') order by id;

# Repeated executions change the query tokens without changing the indexed data.
prepare lookup_sql from 'select id, round(match(title, body) against (?), 8) as score from docs where match(title, body) against (?) order by id';
set @query = 'database';
execute lookup_sql using @query, @query;
set @query = 'running search';
execute lookup_sql using @query, @query;
set @query = 'database';
execute lookup_sql using @query, @query;
deallocate prepare lookup_sql;

# Updating and deleting rows checks that word counts/doc lengths built by DDL
# have the same meaning as those generated by subsequent DML.
update docs set title = 'Updated engines', body = 'Search search running 数据库优化' where id = 1;
delete from docs where id = 2;
insert into docs values (9, 'New database', 'Database searching 数据库全文检索');
select id, round(match(title, body) against ('database search'), 8) as score
from docs where match(title, body) against ('database search') order by id;
select id, round(match(body) against ('数据库全文检索'), 8) as score
from docs where match(body) against ('数据库全文检索') order by id;
select id from docs where match(title, body) against ('+database +search' in boolean mode) order by id;

# A table without a primary key uses generated document IDs instead.
create table generated_docs (id int, body varchar(256)) charset utf8mb4;
insert into generated_docs values
  (1, 'alpha alpha beta'), (2, 'beta gamma'),
  (3, ''), (4, NULL), (5, 'the and or'), (6, 'alpha gamma');
create fulltext index ft_generated on generated_docs(body) with parser beng;
select id, round(match(body) against ('alpha beta'), 8) as score
from generated_docs where match(body) against ('alpha beta') order by id;
update generated_docs set body = 'gamma gamma' where id = 1;
delete from generated_docs where id = 2;
insert into generated_docs values (7, 'alpha beta beta');
select id, round(match(body) against ('alpha beta'), 8) as score
from generated_docs where match(body) against ('alpha beta') order by id;

drop database fts_hot_path;
