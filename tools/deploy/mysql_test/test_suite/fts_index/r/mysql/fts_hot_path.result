create table generated_docs (id int, body varchar(256)) charset utf8mb4;
insert into generated_docs values
(1, 'alpha alpha beta'), (2, 'beta gamma'),
(3, ''), (4, NULL), (5, 'the and or'), (6, 'alpha gamma');
create fulltext index ft_generated on generated_docs(body) with parser beng;
select id, round(match(body) against ('alpha beta'), 8) as score
from generated_docs where match(body) against ('alpha beta') order by id;
id	score
1	1.82997747
2	0.87373693
6	0.87373693
update generated_docs set body = 'gamma gamma' where id = 1;
delete from generated_docs where id = 2;
insert into generated_docs values (7, 'alpha beta beta');
select id, round(match(body) against ('alpha beta'), 8) as score
from generated_docs where match(body) against ('alpha beta') order by id;
id	score
6	0.87373693
7	3.04810346
drop database fts_hot_path;
