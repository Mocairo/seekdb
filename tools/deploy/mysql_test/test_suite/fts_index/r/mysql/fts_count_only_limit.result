set @seen = 0;
select count(*) from (select @seen := id assigned from docs where match(body) against('cobalt amber') limit 7) t;
count(*)
7
select @seen;
@seen
76
delete from docs where mod(id, 2) = 0;
select count(*) from (select id from docs where match(body) against('cobalt amber') limit 1000 offset 20) t;
count(*)
22
drop database fts_count_only_limit;
